# 运行产物
data/
*.log
__pycache__/
*.pyc
.venv/
venv/

# 回测报告与中间文件
*.html
*.xml
# 例外：面板模板是源代码，不是报告，必须进仓库
!tools/*.html
!docs/*.md

# 面板冒烟用的 API 快照（含账户数据，本地生成，不入库）
live_probe.json

# 密钥（永远不要提交）
.env
# .env.bak / .env.local 这类备份曾经真的混进来过一次（里面是真实 key），
# 堵死整类：只放行 .env.example 这个空模板。
.env.*
!.env.example
*.key

# 系统垃圾
.DS_Store
Thumbs.db

# 本机工具数据与快捷方式
# .workbuddy/ 里有会话记忆（含账户号），快捷方式指向本机路径，都不该入库。
.workbuddy/
*.lnk

# 打包产物（tools/build_portable.bat 生成）
build/
dist/
# 绿色版的配置目录（含 API key，绝不能提交）
config/

# 安装包产物
dist/installer/
installer/*.isl
