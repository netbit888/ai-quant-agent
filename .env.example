# 复制本文件为 .env 并填入真实值（.env 已被 gitignore，不会提交）

# ---- 当前使用的供应商 ----
# 通用 key，优先级高于 DEEPSEEK_API_KEY。换供应商时改这一个区块即可。
LLM_API_KEY=在这里填你的key
# 智谱 GLM-4-Flash（免费档，国内直连，OpenAI 兼容）
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 控制台里免费 Flash 的名字会更新（如 glm-4.7-flash / glm-5.x-flash），以控制台为准
LLM_MODEL=glm-4-flash

# ---- 备选：DeepSeek（默认，决策质量更好，按量付费）----
# LLM_API_KEY=sk-在这里填deepseek的key
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# ---- 备选：硅基流动（部分开源模型永久免费）----
# LLM_API_KEY=sk-在这里填siliconflow的key
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=Qwen/Qwen3-8B
